mainmenu "MQTT over Ethernet + TLS application"

menu "MQTT application"

config APP_MQTT_BROKER_HOSTNAME
	string "Broker host name or IPv4 address"
	default "test.mosquitto.org"
	help
	  Resolved with DNS before every connection attempt, so a broker that
	  moves to a new address is picked up on the next reconnect.

config APP_MQTT_BROKER_PORT
	int "Broker TCP port"
	default 8883 if APP_MQTT_TLS
	default 1883
	range 1 65535

config APP_MQTT_CLIENT_ID
	string "MQTT client identifier"
	default ""
	help
	  Leave empty to derive a stable identifier from the MCU's unique
	  device ID: APP_MQTT_CLIENT_ID_PREFIX followed by 20 base32
	  characters (the 96-bit STM32 UID as is; longer UIDs, such as the
	  128-bit NXP MCX UID, condensed to 96 bits with SHA-256), so every
	  board gets its own id without per-device configuration. Must not contain '+', '#' or
	  '/', since it is also a topic level.

config APP_MQTT_CLIENT_ID_PREFIX
	string "Prefix of the derived client identifier"
	default "z"
	help
	  MQTT 3.1.1 brokers are only required to accept client identifiers
	  of 1-23 alphanumeric characters. With a 20-character device ID, a
	  prefix of up to 3 letters or digits stays within that limit. Most
	  brokers accept longer identifiers.

config APP_MQTT_TOPIC_ROOT
	string "Root of the device's topic tree"
	default "bacnet-uc"
	help
	  Topics are "<root>/<client id>/status", ".../info", ".../telemetry",
	  ".../cmd" and ".../event". May contain '/', but no wildcards and no
	  leading '$'.

	  Commands on ".../cmd" must be published without the retain flag:
	  retained commands are ignored, because the broker would replay them
	  after every reconnect.

config APP_MQTT_USERNAME
	string "User name (empty: none)"
	default ""

config APP_MQTT_PASSWORD
	string "Password (empty: none)"
	default ""
	help
	  Requires APP_MQTT_USERNAME (MQTT 3.1.1). Stored in the firmware
	  image in clear text, and sent in clear text on the wire unless both
	  APP_MQTT_TLS and APP_MQTT_TLS_PEER_VERIFY are enabled. Prefer client
	  certificates (APP_MQTT_TLS_CLIENT_AUTH) where the broker supports
	  them.

config APP_MQTT_PUBLISH_INTERVAL_SEC
	int "Telemetry publish interval (seconds)"
	default 10
	range 1 86400

config APP_MQTT_PUBLISH_QOS
	int "QoS of telemetry messages"
	default 1
	range 0 1
	help
	  QoS 1 makes the broker acknowledge each message and gives
	  at-least-once delivery from the broker to its subscribers. The
	  device itself keeps no outgoing queue and uses clean sessions, so a
	  message still in flight when the connection drops is lost either
	  way. QoS 2 is not offered for the same reason.

config APP_MQTT_CONNACK_TIMEOUT_MS
	int "Time to wait for CONNACK or SUBACK (ms)"
	default 10000
	range 1000 120000
	help
	  Applies after the TCP/TLS connection is up. The TCP connect and the
	  TLS handshake are bounded separately by
	  CONFIG_NET_SOCKETS_CONNECT_TIMEOUT and
	  CONFIG_NET_SOCKETS_TLS_CONNECT_TIMEOUT.

config APP_MQTT_RECONNECT_MIN_MS
	int "Initial reconnect back-off (ms)"
	default 1000
	range 100 600000

config APP_MQTT_RECONNECT_MAX_MS
	int "Maximum reconnect back-off (ms)"
	default 60000
	range 100 600000

config APP_MQTT_BUFFER_SIZE
	int "MQTT RX and TX buffer size (bytes)"
	default 1024
	range 256 65535
	help
	  Upper bound for one outgoing MQTT packet and for the fixed and
	  variable header of an incoming one. Incoming payloads are read
	  separately (see APP_MQTT_MAX_PAYLOAD_SIZE).

config APP_MQTT_MAX_PAYLOAD_SIZE
	int "Largest command payload that is processed (bytes)"
	default 128
	range 1 4096
	help
	  Longer payloads on the command topic are read and discarded so the
	  connection stays in sync.

config APP_MQTT_TLS
	bool "Use TLS (MQTTS)"
	default y
	depends on MQTT_LIB_TLS

if APP_MQTT_TLS

config APP_MQTT_TLS_CA_CERT_FILE
	string "CA certificate used to verify the broker (PEM or .der)"
	default "certs/mosquitto.org.crt"
	help
	  Path is relative to the application directory unless absolute.
	  The default is the CA of the public test broker test.mosquitto.org.

	  Must be signed with SHA-256 or stronger: SHA-1 is not built in, so
	  roots that are self-signed with SHA-1 (e.g. "DigiCert Global Root
	  CA") cannot be loaded. Use a SHA-256 root or the SHA-256-signed
	  intermediate as trust anchor instead. The file is parsed at boot and
	  errors are reported there.

config APP_MQTT_TLS_PEER_VERIFY
	bool "Verify the broker certificate"
	default y
	help
	  Checks the broker's certificate chain against the CA and its name
	  against APP_MQTT_TLS_HOSTNAME. Validity dates are NOT checked
	  (CONFIG_MBEDTLS_HAVE_TIME_DATE is off, as the board has no trusted
	  clock at boot), so expired certificates are accepted.

	  Disabling this makes the connection vulnerable to
	  man-in-the-middle attacks. Only for bring-up.

config APP_MQTT_TLS_HOSTNAME
	string "Expected host name in the broker certificate, and SNI"
	default ""
	help
	  Sent as TLS Server Name Indication and matched against the broker
	  certificate. Leave empty to use APP_MQTT_BROKER_HOSTNAME. Set it
	  when the broker is addressed by IP address: an IP literal is then
	  sent as SNI, which RFC 6066 forbids and multi-tenant cloud brokers
	  reject.

config APP_MQTT_TLS_CLIENT_AUTH
	bool "Authenticate with a client certificate (mutual TLS)"

config APP_MQTT_TLS_CLIENT_CERT_FILE
	string "Client certificate (PEM or .der)"
	depends on APP_MQTT_TLS_CLIENT_AUTH
	default "certs/dev/client.crt"
	help
	  The default matches the output of scripts/gen_dev_certs.sh.

config APP_MQTT_TLS_CLIENT_KEY_FILE
	string "Client private key (unencrypted PEM or .der)"
	depends on APP_MQTT_TLS_CLIENT_AUTH
	default "certs/dev/client.key"
	help
	  The default matches the output of scripts/gen_dev_certs.sh.

	  The key is stored unencrypted in flash, and in the build directory
	  (zephyr/include/generated/app_creds). Protect it with flash read-out
	  protection (RDP) on production parts, or move it into a secure
	  element.

endif # APP_MQTT_TLS

config APP_WAIT_FOR_NETWORK
	bool "Wait for an IPv4 address before connecting"
	default y
	depends on NET_CONNECTION_MANAGER
	help
	  Uses the connection manager to wait until the default interface is
	  up and has an IPv4 address, and drops the MQTT session when the
	  network goes away.

config APP_WATCHDOG
	bool "Reboot if the main loop stalls"
	default y if $(dt_alias_enabled,watchdog0)
	depends on TASK_WDT
	help
	  Uses a task watchdog channel, backed by the hardware watchdog.
	  Every blocking call in the application is bounded well below the
	  timeout, so a reset means a genuine wedge.

config APP_WATCHDOG_TIMEOUT_SEC
	int "Watchdog timeout (seconds)"
	depends on APP_WATCHDOG
	default 120
	range 60 3600

config APP_DHCPV4
	bool "Start DHCPv4 on the default interface"
	default y
	depends on NET_DHCPV4 && !NET_CONFIG_SETTINGS
	help
	  When CONFIG_NET_CONFIG_SETTINGS is used instead, the net_config
	  library assigns the (static or DHCP) address.

endmenu

module = APP
module-str = app
source "subsys/logging/Kconfig.template.log_config"

source "Kconfig.zephyr"
