/* SPDX-License-Identifier: Apache-2.0 */

/* MCUboot variant (FILE_SUFFIX=mcuboot): MCUboot in boot_partition, the image
 * in slot0, updates via slot1 + scratch. Runtime settings use the board's
 * storage_partition (2 x 32 KiB sectors @0x10000), which is free here.
 */

/* PA7 is RMII CRS_DV; the board DTS also enables SPI1 with MOSI on PA7. */
&spi1 {
	status = "disabled";
};

/ {
	chosen {
		zephyr,settings-partition = &storage_partition;
	};
};
