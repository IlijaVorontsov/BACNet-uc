/* SPDX-License-Identifier: Apache-2.0 */

/* Stable per-chip MAC (NXP OUI with the locally administered bit, plus the
 * CRC-24 of the 128-bit UID) instead of a new random MAC on every boot, which
 * would also mean a new DHCP lease after every watchdog reset.
 */
&enet_mac {
	/delete-property/ zephyr,random-mac-address;
	nxp,unique-mac;
};

/* Runtime settings: the last 64 KiB of the external W25Q64 NOR flash
 * (4 KiB sectors), in both the plain and the MCUboot variant. The internal
 * flash is fully taken by MCUboot and its two slots. The board's
 * storage_partition spans the whole W25Q64 and is used by other firmware on
 * this board (BACnet); keeping to the top 64 KiB means switching firmware
 * does not wipe each other's settings, as long as they stay below 0x7F0000.
 */
/delete-node/ &storage_partition;

&w25q64jvssiq {
	partitions {
		settings_partition: partition@7f0000 {
			label = "settings";
			reg = <0x7f0000 DT_SIZE_K(64)>;
		};
	};
};

/ {
	chosen {
		zephyr,settings-partition = &settings_partition;
	};
};
