# HIL bench description for profile P1 (NUCLEO-F767ZI DUT, NUCLEO-F767ZI stimulus).
# Copy to /etc/hil/<bench>/bench.yml, fill in the serials and the DUT MAC, and pass it with
# 'pytest --hil --bench /etc/hil/<bench>/bench.yml' (or HIL_BENCH=...).
name: bench1
mode: hil

dut:
  profile: P1
  board: nucleo_f767zi
  serial: /dev/hil/dut0            # ST-LINK VCP of the DUT (udev symlink)
  probe: "0671FF000000000000000000" # ST-LINK serial, for pyocd -u / west flash --dev-id
  # The DUT's real MAC keys the dnsmasq reservation for 192.0.2.10. On Zephyr 4.4.2 the
  # STM32 MAC is 02:80:e1 plus a CRC of the UID: learn it once from the DUT's console or
  # HIL-READY line (no forced MAC in the firmware).
  mac: "02:80:e1:00:00:00"
  ip: 192.0.2.10
  bacnet_instance: 260001
  mqtt_client_id: hil-dut1         # empty in firmware = "z" + 20 base32 chars of the UID

stim:
  serial: /dev/hil/stim0           # ST-LINK VCP of the stimulus board
  baud: 115200
  # DUT channels from firmware/boards/io/nucleo_f767zi.dtsi (BACnet branch), named as the
  # DUT channel each stimulus pin is wired to, plus the rig channels.
  chans:
    - di0     # PC13 B1 user button
    - di1     # PF15 Arduino D2
    - di2     # PF14 Arduino D4
    - do0     # PB0  LD1 green
    - do1     # PB7  LD2 blue
    - do2     # PB14 LD3 red
    - do3     # PF13 Arduino D7
    - do4     # PF12 Arduino D8
    - ai0     # PA3  Arduino A0 (ADC1_IN3)
    - ai1     # PC0  Arduino A1 (ADC1_IN10)
    - ai2     # PC3  Arduino A2 (ADC1_IN13)
    - ai3     # PF3  Arduino A3 (ADC3_IN9)
    - ai4     # PF5  Arduino A4 (ADC3_IN15)
    - ai5     # PF10 Arduino A5 (ADC3_IN8)
    - ao0     # PE9  Arduino D6 (TIM1_CH1 PWM)
    - ao1     # PE11 Arduino D5 (TIM1_CH2 PWM)
    - ao2     # PE13 Arduino D3 (TIM1_CH3 PWM)
    - nrst        # DUT NRST, open drain
    - nrst_sense  # DUT NRST level
    - pwr         # DUT E5V power switch
    - sync        # SYNC pulse to the logic analyzer
    - m0          # DUT timing markers (HIL snippet)
    - m1
    - m2
    - m3

net:
  dut_iface: enx00e04c680001       # host NIC cabled to the DUT; moved into netns lan-a

la:
  driver: fx2lafw                  # minimal tier (decision B9)
  channels: {do3: 0, di1: 1, m0: 2, m1: 3, nrst_sense: 4, sync: 7}

mstp:
  ftdi: /dev/hil/rs485
  baud: 38400

power:
  method: stim
