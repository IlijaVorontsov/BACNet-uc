# Secrets for uc-hub; install as /etc/uc-hub/uc-hub.env (root:uchub, mode 0640).
# systemd passes them to the hub; hub.yaml only names the variables.

# Z.ai API key for the standard, pay-as-you-go API (https://api.z.ai/api/paas/v4).
# A GLM Coding Plan subscription key is not for this: Z.ai limits the plan
# to its supported coding tools.
ZAI_API_KEY=

# Bearer tokens for the web app, one per person; generate each with
#   openssl rand -hex 32
# and open the app once as https://<hub>/?token=<token> on each device.
UC_HUB_TOKEN_ADMIN=
UC_HUB_TOKEN_TECH=
