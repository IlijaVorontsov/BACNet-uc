/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * NUCLEO-F767ZI
 *
 * Storage: external SPI NOR flash, Winbond W25Q128JV (16 MiB, 4 KiB
 * sectors, 3.3 V), on SPI1 of the ST Zio connector CN7:
 *
 *   flash   MCU   connector
 *   CLK     PA5   CN7-10  (D13)
 *   DO      PA6   CN7-12  (D12)
 *   DI      PB5   CN7-13  (D22)   not PA7 (D11): PA7 is RMII CRS_DV of
 *                                 the on-board Ethernet PHY
 *   /CS     PD14  CN7-16  (D10)
 *   VCC     3V3   CN8-7,  GND  CN8-11
 *   /WP and /HOLD tied to 3V3 (on most W25Q breakout modules already)
 *
 * LittleFS uses the 4 KiB sectors as blocks (4096 blocks; the firmware
 * Kconfig sets CONFIG_SPI_NOR_FLASH_LAYOUT_PAGE_SIZE=4096), with the fstab
 * read/prog/cache sizes below (cache-size = CONFIG_FS_LITTLEFS_CACHE_SIZE).
 *
 * The internal flash is not used for data: without MCUboot the application
 * is linked at flash offset 0 and overlaps the board's storage_partition at
 * 0x10000 (the image is larger than 64 KiB).
 *
 * Network: on-board RMII Ethernet (LAN8742A); the MAC address is derived
 * from the MCU unique ID (stable across reboots).
 *
 * RAM: the WAMR pool (CONFIG_UC_APP_POOL_SIZE) lives in the 128 KiB DTCM
 * (chosen "uc,app-pool", see nucleo_f767zi.conf for the budget), next to
 * the Ethernet DMA descriptors and buffers (~12.3 KiB,
 * CONFIG_ETH_STM32_HAL_USE_DTCM_FOR_DMA_BUFFER). The 384 KiB SRAM1/2
 * (zephyr,sram) holds everything else.
 */

#include "io/nucleo_f767zi.dtsi"

&spi1 {
	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pb5>;
	pinctrl-names = "default";
	cs-gpios = <&gpiod 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	status = "okay";

	uc_nor: w25q128jv@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(24)>;
		jedec-id = [ef 40 18];
		size = <DT_SIZE_M(128)>; /* bits */
		has-dpd;
		t-enter-dpd = <3000>;
		t-exit-dpd = <3000>;
		status = "okay";

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			uc_storage_partition: partition@0 {
				label = "uc-storage";
				reg = <0x00000000 DT_SIZE_M(16)>;
			};
		};
	};
};

/ {
	chosen {
		uc,app-pool = &dtcm;
	};

	fstab {
		compatible = "zephyr,fstab";

		uc_lfs: lfs {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs";
			partition = <&uc_storage_partition>;
			automount;
			/* formatting is decided by uc_storage (CONFIG_UC_STORAGE_FORMAT_ON_FAIL) */
			no-format;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <256>;
			lookahead-size = <256>;
			block-cycles = <512>;
		};
	};
};
