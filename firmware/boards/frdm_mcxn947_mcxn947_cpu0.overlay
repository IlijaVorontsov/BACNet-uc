/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * FRDM-MCXN947, core 0.
 *
 * Storage: the board's storage_partition, the whole 8 MiB Winbond W25Q64JV
 * QSPI flash on FlexSPI (4 KiB erase blocks). The application runs from
 * the internal flash, so the external flash is data only.
 *
 * Network: ENET QOS with the on-board PHY. The MAC address is derived from
 * the chip unique ID instead of the board default random address, so a
 * node keeps its DHCP lease across reboots.
 */

#include "io/frdm_mcxn947_mcxn947_cpu0.dtsi"

&enet_mac {
	/delete-property/ zephyr,random-mac-address;
	nxp,unique-mac;
};

/ {
	fstab {
		compatible = "zephyr,fstab";

		uc_lfs: lfs {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs";
			partition = <&storage_partition>;
			automount;
			/* formatting is decided by uc_storage (CONFIG_UC_STORAGE_FORMAT_ON_FAIL) */
			no-format;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <256>;
			lookahead-size = <256>;
			block-cycles = <512>;
		};
	};
};
