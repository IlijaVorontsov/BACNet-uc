mainmenu "BACnet-uc firmware"

menu "BACnet-uc"

config UC_FW_VERSION
	string "Firmware version string"
	default "0.1.0"

# --- storage ------------------------------------------------------------

config UC_STORAGE_FORMAT_ON_FAIL
	bool "Format /lfs when mounting fails"
	default y

# /lfs on a jedec,spi-nor flash (NUCLEO-F767ZI overlay): the flash page
# size of the driver becomes the LittleFS block size. 4 KiB (the erase
# sector of the W25Q family) instead of the driver's 64 KiB default gives
# 4096 blocks on a 16 MiB chip and small files one 4 KiB block each. Set
# here rather than in the board .conf so that builds without the flash node
# (uc-ramfs snippet) do not warn about an unused assignment.
config SPI_NOR_FLASH_LAYOUT_PAGE_SIZE
	default 4096
	depends on SPI_NOR

# --- configuration documents -------------------------------------------

config UC_CONFIG_DOC_MAX
	int "Maximum size of a configuration document (bytes)"
	default 8192

config UC_DEVICE_INSTANCE_DEFAULT
	int "Default BACnet device instance (no device.json)"
	range 0 4194302
	default 260001

config UC_DEVICE_NAME_DEFAULT
	string "Default BACnet device name (no device.json)"
	default "bacnet-uc"

# --- BACnet -------------------------------------------------------------

config UC_BACNET_THREAD_STACK_SIZE
	int "BACnet thread stack size"
	default 8192

config UC_BACNET_THREAD_PRIORITY
	int "BACnet thread priority"
	default 5

config UC_BACNET_POLL_MS
	int "BACnet loop period (ms)"
	default 5

config UC_BACNET_EXEC_QUEUE_LEN
	int "Executor queue length"
	default 16

config UC_BACNET_CLIENT_SLOTS
	int "Concurrent remote client transactions"
	default 8

config UC_BACNET_COV_SUBS_MAX
	int "Application COV subscriptions (local + remote)"
	default 16

config UC_BACNET_COV_POLL_MS
	int "Poll period when a remote device does not support COV (ms)"
	default 2000

config UC_BACNET_STATIC_BINDINGS_MAX
	int "Static device bindings from device.json"
	default 16

config UC_BACNET_OBJECTS_MAX
	int "Owner table size (objects created by IO, apps and CreateObject)"
	default 64

config UC_BACNET_REMOTE_CREATE_DELETE
	bool "Accept CreateObject/DeleteObject from the network"
	help
	  n: both services are not registered; BACnet clients get a Reject
	  (unrecognized-service) and Protocol_Services_Supported omits them.
	  y: clients may create AI, AO, AV, BI, BO, BV, MSI, MSO and MSV
	  objects (owner "network", one owner table entry each, RAM only) and
	  delete only those. Objects of the system, of io.json and of
	  applications answer Error object/object-deletion-not-permitted.

config UC_BACNET_REQUIRE_PASSWORD
	bool "Refuse ReinitializeDevice and DCC without a configured password"
	default y
	help
	  ReinitializeDevice and DeviceCommunicationControl use device.json
	  bacnet.password (1..20 characters) when it is set. Without one:
	  y: both services answer Error security/password-failure;
	  n: both services are accepted without a password (open device).

config UC_NET_WAIT_MS
	int "Time to wait for an IPv4 address before starting BACnet anyway (ms)"
	default 30000

# --- IO -----------------------------------------------------------------

config UC_IO_POINTS_MAX
	int "IO points in io.json"
	default 32

# --- WebAssembly applications ------------------------------------------

config UC_APPS
	bool "WebAssembly applications"
	default y
	select WAMR

# Table sizes are used by the configuration module even without the
# runtime (apps.json is still parsed and served), so they live outside
# "if UC_APPS".
config UC_APPS_MAX
	int "Installed applications"
	range 1 8
	default 4

config UC_APP_PARAMS_MAX
	int "Parameters per application"
	default 16

if UC_APPS

config UC_APP_POOL_SIZE
	int "WAMR memory pool (bytes)"
	default 131072
	help
	  All module images, instances, linear memories and app heaps are
	  allocated from this pool.

config UC_APP_THREAD_STACK_SIZE
	int "Native stack of an application thread"
	default 8192

config UC_APP_THREAD_PRIORITY
	int "Application thread priority (preemptible, lower than BACnet)"
	default 10

config UC_APP_MAX_FILE_SIZE
	int "Maximum module size (bytes)"
	default 262144

config UC_APP_WATCHDOG_MS
	int "Execution time budget of one application callback (ms)"
	default 2000
	help
	  A callback (uc_app_init, uc_app_tick, uc_app_on_cov, uc_app_on_write,
	  uc_app_deinit) that executes longer is terminated
	  (wasm_runtime_terminate()) and the application enters "failed". Time
	  blocked in remote requests and kv file access does not count, except
	  while a stop is pending: a stop cancels the blocking host calls, so
	  the rest of the running callback and uc_app_deinit() each end within
	  this period, and uc_apps_stop() waits at most 2 x this period + 8 s.
	  The timer runs in real time on the boards. On native_sim simulated
	  time stands still while a callback computes, so the timer cannot stop
	  a busy loop there; WAMR_INSTRUCTION_LIMIT (an instruction budget per
	  call, interpreter only) does.

config UC_APP_EVENT_QUEUE_LEN
	int "Pending events per application"
	default 16

config UC_APP_KV_VALUE_MAX
	int "Maximum value size of the app key/value store"
	default 256

endif # UC_APPS

# --- management ---------------------------------------------------------

config UC_MGMT
	bool "Custom MCUmgr groups (uc_app, uc_io, uc_node)"
	default y
	depends on MCUMGR

config UC_SHELL
	bool "'uc' shell commands"
	default y
	depends on SHELL

module = UC
module-str = BACnet-uc
