### t046 A10 A6 A6a A8 A9
# In maintenance the state machine runs (state reported truthfully) but nothing is
# emitted and no episode starts. maint off emits one catch-up TO_HIGH, which starts the
# episode at 310.
cfg high=30 low=10 deadband=2 delay=0 escalate=100
init 0
s 0 20
maint 10 on
s 20 35
s 30 5
sf 40 5
s 50 35
tick 300
maint 310 off
tick 409
tick 410
---
cfg
NORMAL
NORMAL
NORMAL
HIGH
LOW
FAULT
HIGH
HIGH
HIGH TO_HIGH@310:35.000
HIGH
HIGH ESCALATE@410:35.000

### t047 A10 A8
# Silent HIGH->NORMAL->HIGH in maintenance: no episode starts, and no catch-up because
# the state equals the last emitted transition (TO_HIGH). The acked episode stays acked.
cfg high=30 low=10 deadband=2 delay=0 escalate=100
init 0
s 10 35
ack 20
maint 30 on
s 40 20
s 50 35
maint 60 off
tick 1000
---
cfg
NORMAL
HIGH TO_HIGH@10:35.000
HIGH
HIGH
NORMAL
HIGH
HIGH
HIGH

### t048 A10 A8 A9
# Catch-up TO_LOW starts a new episode (alarm time 250) before the escalation check, so the
# overdue HIGH episode does not escalate at 250; the new one escalates at 350.
cfg high=30 low=10 deadband=2 delay=0 escalate=100
init 0
s 10 35
maint 20 on
s 30 5
tick 200
maint 250 off
tick 349
tick 350
---
cfg
NORMAL
HIGH TO_HIGH@10:35.000
HIGH
LOW
LOW
LOW TO_LOW@250:5.000
LOW
LOW ESCALATE@350:5.000

### t049 A10 A9 A11 A8
# Catch-up TO_NORMAL does not end the episode; the overdue episode escalates right after.
cfg high=30 low=10 deadband=2 delay=0 escalate=100
init 0
s 10 35
maint 20 on
s 30 20
tick 200
maint 250 off
tick 400
---
cfg
NORMAL
HIGH TO_HIGH@10:35.000
HIGH
NORMAL
NORMAL
NORMAL TO_NORMAL@250:20.000 ESCALATE@250:20.000
NORMAL

### t050 A10 A9
# Escalation is due at 110, but at the end of the maint-on call (150) the point is in
# maintenance, so it waits until maint off.
cfg high=30 low=10 deadband=2 delay=0 escalate=100
init 0
s 10 35
maint 150 on
tick 200
maint 210 off
---
cfg
NORMAL
HIGH TO_HIGH@10:35.000
HIGH
HIGH
HIGH ESCALATE@210:35.000

### t051 A10 A6 A9 A11 A7
# A fault in maintenance is silent; catch-up TO_FAULT (value of the fault sample), then the
# still-unacknowledged HIGH episode escalates.
cfg high=30 low=10 deadband=2 delay=0 escalate=100
init 0
s 10 35
maint 20 on
sf 30 12
maint 200 off
---
cfg
NORMAL
HIGH TO_HIGH@10:35.000
HIGH
FAULT
FAULT TO_FAULT@200:12.000 ESCALATE@200:12.000

### t052 A10
# Turning maintenance on when on, or off when off, changes nothing (a second "on" must
# not toggle it off; a second "off" must not emit another catch-up).
cfg high=30 low=10 deadband=2 delay=0 escalate=0
init 0
s 10 35
s 20 20
maint 30 on
maint 40 on
s 50 35
maint 60 off
maint 70 off
s 80 20
---
cfg
NORMAL
HIGH TO_HIGH@10:35.000
NORMAL TO_NORMAL@20:20.000
NORMAL
NORMAL
HIGH
HIGH TO_HIGH@60:35.000
HIGH
NORMAL TO_NORMAL@80:20.000

### t053 A10 A5a A7 A3
# Timers keep running across maintenance: pending LOW (start 40) fires silently at 70;
# pending NORMAL (start 80) survives maint off. The catch-up TO_LOW carries the most
# recent sample value (20), and the return fires at 110.
cfg high=30 low=10 deadband=2 delay=30 escalate=0
init 0
s 0 35
s 30 35
s 40 5
maint 50 on
tick 70
s 80 20
maint 100 off
tick 110
---
cfg
NORMAL
NORMAL
HIGH TO_HIGH@30:35.000
HIGH
HIGH
LOW
LOW
LOW TO_LOW@100:20.000
NORMAL TO_NORMAL@110:20.000

### t054 A10 A6a
# Recovery in maintenance is silent; the catch-up at maint off reports NORMAL
# (last emitted transition was TO_FAULT).
cfg high=30 low=10 deadband=2 delay=0 escalate=0
init 0
sf 10 0
maint 20 on
s 30 20
maint 40 off
---
cfg
NORMAL
FAULT TO_FAULT@10:0.000
FAULT
NORMAL
NORMAL TO_NORMAL@40:20.000

### t055 A10 A8 A9
# ack during maintenance acknowledges the episode: nothing escalates after maint off.
cfg high=30 low=10 deadband=2 delay=0 escalate=100
init 0
s 10 35
maint 20 on
ack 30
maint 200 off
tick 300
---
cfg
NORMAL
HIGH TO_HIGH@10:35.000
HIGH
HIGH
HIGH
HIGH

### t056 A12
# Calls earlier than init are ignored entirely (even a fault); equal times are fine.
cfg high=30 low=10 deadband=2 delay=0 escalate=0
init 100
s 50 35
sf 99 35
s 100 35
s 100 20
---
cfg
NORMAL
NORMAL
NORMAL
