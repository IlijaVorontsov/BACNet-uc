### t057 A12 A8 A9
# A backwards ack is ignored, so the episode is still unacknowledged and escalates.
cfg high=30 low=10 deadband=2 delay=0 escalate=100
init 0
s 200 35
ack 150
tick 300
---
cfg
NORMAL
HIGH TO_HIGH@200:35.000
HIGH
HIGH ESCALATE@300:35.000

### t058 A12 A5a
# Backwards samples are ignored: they neither cancel the pending HIGH nor replace the value.
cfg high=30 low=10 deadband=2 delay=30 escalate=0
init 0
s 100 35
s 90 20
sf 95 20
tick 130
---
cfg
NORMAL
NORMAL
NORMAL
NORMAL
HIGH TO_HIGH@130:35.000

### t059 A12 A10
# A backwards "maint off" is ignored (no escalation, maintenance stays on), so the TO_LOW
# at 250 is silent; the real maint off emits the catch-up (new episode, no escalation).
cfg high=30 low=10 deadband=2 delay=0 escalate=100
init 0
s 10 35
maint 200 on
maint 150 off
s 250 5
maint 260 off
---
cfg
NORMAL
HIGH TO_HIGH@10:35.000
HIGH
HIGH
LOW
LOW TO_LOW@260:5.000
