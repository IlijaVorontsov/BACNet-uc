cfg
NORMAL
LOW TO_LOW@10:5.000
FAULT TO_FAULT@20:35.000

### t024 A6 A6a A5a
# fault ignores the delay and cancels pending; no timers in FAULT; recovery restarts the delay
cfg high=30 low=10 deadband=2 delay=30 escalate=0
init 0
