FAULT
NORMAL TO_NORMAL@110:35.000
NORMAL
HIGH TO_HIGH@140:35.000

### t025 A6a A11 A6
# recovery with delay 0: TO_NORMAL then limit transition in one call; always to NORMAL first
cfg high=30 low=10 deadband=2 delay=0 escalate=0
init 0
sf 10 0
s 20 35
sf 30 0
s 40 -inf
sf 50 0
s 60 11
---
cfg
NORMAL
FAULT TO_FAULT@10:0.000
HIGH TO_NORMAL@20:35.000 TO_HIGH@20:35.000
FAULT TO_FAULT@30:0.000
LOW TO_NORMAL@40:-inf TO_LOW@40:-inf
FAULT TO_FAULT@50:0.000
NORMAL TO_NORMAL@60:11.000

### t026 A6a A8 A9
# TO_FAULT and recovery TO_NORMAL do not start an alarm episode
cfg high=30 low=10 deadband=2 delay=0 escalate=50
init 0
sf 10 0
s 20 20
tick 200
---
cfg
NORMAL
FAULT TO_FAULT@10:0.000
NORMAL TO_NORMAL@20:20.000
NORMAL

### t027 A6a A8 A9 A11
# TO_FAULT does not clear unacknowledged; old episode escalates on the recovery call
cfg high=30 low=10 deadband=2 delay=0 escalate=100
init 0
