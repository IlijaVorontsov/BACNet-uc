# Black-box tests for alarm.c, derived from SPEC.md v1.0 only.
# Header tags name the rule ids each block targets.
# Comments are only placed in the input part of a block (run_vectors.py
# would treat a '#' line in the expected part as an expected output line).
# All values are exactly representable in binary floating point.
# Deliberately NOT tested (SPEC.md ambiguous): escalation while in FAULT,
# maint off when no transition notification was ever emitted and the state is NORMAL,
# value of a fault sample received while already in FAULT, redundant maint off at a
# time when a timer/escalation is due, re-init at an earlier time, maintenance across re-init.

### t001 A1 A13 A8 A9
# after init: NORMAL, nothing pending, nothing unacknowledged (ack ignored, no escalation)
cfg high=30 low=10 deadband=2 delay=0 escalate=10
init 5
ack 5
tick 100
---
cfg
NORMAL
NORMAL
NORMAL

### t002 A1
# re-init resets state and acknowledgement status
cfg high=30 low=10 deadband=2 delay=0 escalate=50
init 0
s 10 35
init 20
tick 200
s 210 20
tick 300
---
cfg
NORMAL
HIGH TO_HIGH@10:35.000
NORMAL
NORMAL
NORMAL
NORMAL

### t003 A2 A3 A4
# values exactly at a limit are not offnormal; just beyond is
cfg high=30 low=10 deadband=2 delay=0 escalate=0
init 0
s 10 30
s 20 10
s 30 30.5
s 40 20
s 50 9.5
---
cfg
NORMAL
NORMAL
NORMAL
HIGH TO_HIGH@30:30.500
NORMAL TO_NORMAL@40:20.000
LOW TO_LOW@50:9.500

### t004 A6 A2 A4
# +inf / -inf are valid values (not faults); direct HIGH<->LOW
cfg high=30 low=10 deadband=2 delay=0 escalate=0
init 0
s 10 inf
s 20 -inf
s 30 inf
s 40 20
---
cfg
NORMAL
HIGH TO_HIGH@10:inf
LOW TO_LOW@20:-inf
HIGH TO_HIGH@30:inf
NORMAL TO_NORMAL@40:20.000

### t005 A3
# strict deadband on return from HIGH (<28) and from LOW (>12)
cfg high=30 low=10 deadband=2 delay=0 escalate=0
init 0
s 10 31
s 20 30
s 30 28
s 40 27.75
s 45 29
s 50 9
s 60 10
s 70 12
s 80 12.25
---
cfg
NORMAL
HIGH TO_HIGH@10:31.000
HIGH
HIGH
NORMAL TO_NORMAL@40:27.750
NORMAL
LOW TO_LOW@50:9.000
LOW
LOW
NORMAL TO_NORMAL@80:12.250

### t006 A3 A2
# deadband 0: a value exactly at the limit does not return
cfg high=30 low=10 deadband=0 delay=0 escalate=0
init 0
s 10 31
s 20 30
s 30 29.5
s 40 9
s 50 10
s 60 10.5
---
cfg
NORMAL
HIGH TO_HIGH@10:31.000
HIGH
NORMAL TO_NORMAL@30:29.500
LOW TO_LOW@40:9.000
LOW
NORMAL TO_NORMAL@60:10.500

### t007 A3 A2
# negative limits, fractional deadband: return from HIGH needs < -16.5, from LOW > -28.5
cfg high=-15 low=-30 deadband=1.5 delay=0 escalate=0
init 0
s 10 -14.5
s 20 -16.5
s 30 -16.75
s 40 -31
s 50 -28.5
s 60 -28.25
---
cfg
NORMAL
HIGH TO_HIGH@10:-14.500
HIGH
NORMAL TO_NORMAL@30:-16.750
LOW TO_LOW@40:-31.000
LOW
NORMAL TO_NORMAL@60:-28.250

