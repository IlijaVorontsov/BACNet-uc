### t019 A5a A8 A9
# ack evaluates the timer first: the transition happens, then the new episode is acknowledged
cfg high=30 low=10 deadband=2 delay=30 escalate=100
init 0
s 10 35
ack 40
tick 200
s 210 20
ack 240
tick 1000
---
cfg
NORMAL
NORMAL
HIGH TO_HIGH@40:35.000
HIGH
HIGH
NORMAL TO_NORMAL@240:20.000
NORMAL

### t020 A5a A10 A9
# maint on evaluates the timer first (notification still emitted); escalation waits until off
cfg high=30 low=10 deadband=2 delay=30 escalate=100
init 0
s 10 35
maint 40 on
tick 200
maint 210 off
---
cfg
NORMAL
NORMAL
HIGH TO_HIGH@40:35.000
HIGH
HIGH ESCALATE@210:35.000

### t021 A6 A6a
# sf -> FAULT immediately; further fault samples (sf or NaN) do nothing; recovery
cfg high=30 low=10 deadband=2 delay=30 escalate=0
init 0
sf 10 20
sf 20 20
s 30 nan
tick 40
s 50 20
---
cfg
NORMAL
FAULT TO_FAULT@10:20.000
FAULT
FAULT
FAULT
NORMAL TO_NORMAL@50:20.000

### t022 A6 A7
# NaN on a plain sample is a fault; TO_FAULT carries the NaN value
cfg high=30 low=10 deadband=2 delay=0 escalate=0
init 0
s 10 35
s 20 nan
---
cfg
NORMAL
HIGH TO_HIGH@10:35.000
FAULT TO_FAULT@20:nan

