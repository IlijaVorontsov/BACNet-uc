### a6a-recovery-evaluated-same-call
cfg high=30 low=10 deadband=2 delay=0 escalate=0
init 0
sf 1 20
s 2 35
---
cfg
NORMAL
FAULT TO_FAULT@1:20.000
HIGH TO_NORMAL@2:35.000 TO_HIGH@2:35.000
### a6a-recovery-starts-timer
cfg high=30 low=10 deadband=2 delay=10 escalate=0
init 0
s 1 nan
s 2 35
tick 12
---
cfg
NORMAL
FAULT TO_FAULT@1:nan
NORMAL TO_NORMAL@2:35.000
HIGH TO_HIGH@12:35.000
### a9-escalate-on-recovery-sample
cfg high=30 low=10 deadband=2 delay=0 escalate=100
init 0
s 1 35
sf 50 0
s 101 20
---
cfg
NORMAL
HIGH TO_HIGH@1:35.000
FAULT TO_FAULT@50:0.000
NORMAL TO_NORMAL@101:20.000 ESCALATE@101:20.000
