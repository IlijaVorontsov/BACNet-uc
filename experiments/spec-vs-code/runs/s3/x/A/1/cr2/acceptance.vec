# Acceptance test: the alarm scenarios we care about.
### high-alarm-ack-and-return
cfg high=30 low=10 deadband=2 delay=30 escalate=600
init 0
s 10 25
s 20 35
s 30 35
s 40 35
s 50 35
ack 60
s 70 27
s 80 27
s 90 27
s 100 27
---
cfg
NORMAL
NORMAL
NORMAL
NORMAL
NORMAL
HIGH TO_HIGH@50:35.000
HIGH
HIGH
HIGH
HIGH
NORMAL TO_NORMAL@100:27.000
### low-alarm-unacknowledged-escalates
cfg high=30 low=10 deadband=2 delay=20 escalate=300
init 0
s 0 5
s 10 5
s 20 5
tick 200
tick 320
tick 400
---
cfg
NORMAL
NORMAL
NORMAL
LOW TO_LOW@20:5.000
LOW
LOW ESCALATE@320:5.000
LOW
### short-spikes-do-not-alarm
cfg high=30 low=10 deadband=2 delay=60 escalate=600
init 0
s 10 20
s 20 40
s 30 20
s 40 40
s 50 20
---
cfg
NORMAL
NORMAL
NORMAL
NORMAL
NORMAL
NORMAL
### cr201-short-normal-delay cr201
# CR-201: separate return-to-normal delay (Time_Delay_Normal). Blocks tagged cr201.
cfg high=30 low=10 deadband=2 delay=30 delay_normal=10 escalate=0
init 0
s 10 35
s 40 35
s 50 27
s 59 27
s 60 27
---
cfg
NORMAL
NORMAL
HIGH TO_HIGH@40:35.000
HIGH
HIGH
NORMAL TO_NORMAL@60:27.000
### cr201-long-normal-delay-from-low cr201
cfg high=30 low=10 deadband=2 delay=10 delay_normal=60 escalate=0
init 0
s 0 5
s 10 5
s 20 15
tick 70
tick 80
---
cfg
NORMAL
NORMAL
LOW TO_LOW@10:5.000
LOW
LOW
NORMAL TO_NORMAL@80:15.000
### cr201-offnormal-transitions-keep-time-delay cr201
cfg high=30 low=10 deadband=2 delay=20 delay_normal=0 escalate=0
init 0
s 0 35
s 19 35
s 20 35
s 30 5
s 49 5
s 50 5
s 60 15
---
cfg
NORMAL
NORMAL
NORMAL
HIGH TO_HIGH@20:35.000
HIGH
HIGH
LOW TO_LOW@50:5.000
NORMAL TO_NORMAL@60:15.000
### cr201-fault-to-normal-stays-immediate cr201
cfg high=30 low=10 deadband=2 delay=10 delay_normal=100 escalate=0
init 0
s 0 35
s 10 35
sf 20 35
s 30 20
---
cfg
NORMAL
NORMAL
HIGH TO_HIGH@10:35.000
FAULT TO_FAULT@20:35.000
NORMAL TO_NORMAL@30:20.000
### cr201-sentinel-means-same-as-time-delay cr201
cfg high=30 low=10 deadband=2 delay=30 delay_normal=4294967295 escalate=0
init 0
s 0 35
s 30 35
s 40 27
s 69 27
s 70 27
---
cfg
NORMAL
NORMAL
HIGH TO_HIGH@30:35.000
HIGH
HIGH
NORMAL TO_NORMAL@70:27.000
### cr202-reinit-picks-up-new-config cr202
# CR-202: alarm_init keeps a pointer to the configuration instead of copying it.
# Reconfiguring and re-initialising must behave exactly as before (fresh point, new limits).
cfg high=30 low=10 deadband=2 delay=10 escalate=0
init 0
s 0 35
s 10 35
cfg high=50 low=0 deadband=2 delay=5 escalate=0
init 20
s 20 35
s 30 55
s 35 55
---
cfg
NORMAL
NORMAL
HIGH TO_HIGH@10:35.000
cfg
NORMAL
NORMAL
NORMAL
HIGH TO_HIGH@35:55.000
