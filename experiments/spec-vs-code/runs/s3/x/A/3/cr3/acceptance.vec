### cr203-acked-once-with-latest-value 
# ACKED carries the most recent sample value; a second ack emits nothing
cfg high=30 low=10 deadband=2 delay=10 escalate=0
init 0
ack 0
s 0 35
s 10 36
s 12 38
ack 15
ack 20
s 25 37
ack 30
---
cfg
NORMAL
NORMAL
NORMAL
HIGH TO_HIGH@10:36.000
HIGH
HIGH ACKED@15:38.000
HIGH
HIGH
HIGH
### cr203-ack-in-maintenance-is-silent 
# ack in maintenance clears the unacknowledged status without ACKED (not deferred)
cfg high=30 low=10 deadband=2 delay=10 escalate=600
init 0
s 0 5
s 10 5
maint 20 on
s 25 6
ack 30
maint 40 off
ack 50
tick 700
---
cfg
NORMAL
NORMAL
LOW TO_LOW@10:5.000
LOW
LOW
LOW
LOW
LOW
LOW
### cr203-ack-after-return-to-normal 
# returning to normal does not acknowledge the alarm (BACnet Acked_Transitions), see CR-203 item 2
cfg high=30 low=10 deadband=2 delay=10 escalate=0
init 0
s 0 35
s 10 35
s 20 25
s 30 25
s 40 26
ack 50
ack 60
---
cfg
NORMAL
NORMAL
HIGH TO_HIGH@10:35.000
HIGH
NORMAL TO_NORMAL@30:25.000
NORMAL
NORMAL ACKED@50:26.000
NORMAL
### cr203-ack-after-transition-in-same-call 
cfg high=30 low=10 deadband=2 delay=10 escalate=0
init 0
s 0 35
tick 5
ack 10
---
cfg
NORMAL
NORMAL
NORMAL
HIGH TO_HIGH@10:35.000 ACKED@10:35.000
### cr203-limits-are-exclusive 
# BACnet OUT_OF_RANGE: offnormal only when strictly above High_Limit / below Low_Limit, see CR-203 item 3
cfg high=30 low=10 deadband=0 delay=0 escalate=0
init 0
s 0 30
s 10 10
s 20 30.001
s 30 30
s 40 9.999
s 50 10
---
cfg
NORMAL
NORMAL
NORMAL
HIGH TO_HIGH@20:30.001
HIGH
LOW TO_LOW@40:9.999
LOW
