# Acceptance test: the alarm scenarios we care about.
### high-alarm-ack-and-return
cfg high=30 low=10 deadband=2 delay=30 escalate=600
init 0
s 10 25
s 20 35
s 30 35
s 40 35
s 50 35
ack 60
s 70 27
s 80 27
s 90 27
s 100 27
---
cfg
NORMAL
NORMAL
NORMAL
NORMAL
NORMAL
HIGH TO_HIGH@50:35.000
HIGH
HIGH
HIGH
HIGH
NORMAL TO_NORMAL@100:27.000
### low-alarm-unacknowledged-escalates
cfg high=30 low=10 deadband=2 delay=20 escalate=300
init 0
s 0 5
s 10 5
s 20 5
tick 200
tick 320
tick 400
---
cfg
NORMAL
NORMAL
NORMAL
LOW TO_LOW@20:5.000
LOW
LOW ESCALATE@320:5.000
LOW
### short-spikes-do-not-alarm
cfg high=30 low=10 deadband=2 delay=60 escalate=600
init 0
s 10 20
s 20 40
s 30 20
s 40 40
s 50 20
---
cfg
NORMAL
NORMAL
NORMAL
NORMAL
NORMAL
NORMAL
### cr201-return-to-normal-uses-delay-normal
# CR-201: separate return-to-normal delay (time_delay_normal_s / delay_normal); see all cr201-* blocks.
cfg high=30 low=10 deadband=2 delay=10 delay_normal=50 escalate=0
init 0
s 0 35
s 10 35
s 20 25
s 40 29
s 50 25
tick 90
tick 100
---
cfg
NORMAL
NORMAL
HIGH TO_HIGH@10:35.000
HIGH
HIGH
HIGH
HIGH
NORMAL TO_NORMAL@100:25.000
### cr201-offnormal-and-high-to-low-keep-time-delay
cfg high=30 low=10 deadband=2 delay=30 delay_normal=0 escalate=0
init 0
s 0 35
s 20 35
s 30 35
s 40 5
s 60 5
s 70 5
s 80 20
---
cfg
NORMAL
NORMAL
NORMAL
HIGH TO_HIGH@30:35.000
HIGH
HIGH
LOW TO_LOW@70:5.000
NORMAL TO_NORMAL@80:20.000
### cr201-sentinel-means-same-as-time-delay
cfg high=30 low=10 deadband=2 delay=20 delay_normal=4294967295 escalate=0
init 0
s 0 5
s 20 5
s 30 15
s 49 15
s 50 15
---
cfg
NORMAL
NORMAL
LOW TO_LOW@20:5.000
LOW
LOW
NORMAL TO_NORMAL@50:15.000
### cr201-fault-recovery-stays-immediate
cfg high=30 low=10 deadband=2 delay=0 delay_normal=100 escalate=0
init 0
sf 0 20
s 10 20
---
cfg
NORMAL
FAULT TO_FAULT@0:20.000
NORMAL TO_NORMAL@10:20.000
