HIGH
NORMAL TO_NORMAL@50:20.000
NORMAL
### acked-after-return-to-normal-reports-latest-value 
cfg high=30 low=10 deadband=2 delay=0 escalate=600
init 0
s 10 5
s 20 15
tick 100
ack 110
tick 700
---
cfg
NORMAL
LOW TO_LOW@10:5.000
NORMAL TO_NORMAL@20:15.000
NORMAL
NORMAL ACKED@110:15.000
NORMAL
### acked-follows-transition-in-same-call 
cfg high=30 low=10 deadband=2 delay=30 escalate=600
init 0
s 10 35
ack 40
tick 700
---
cfg
NORMAL
NORMAL
HIGH TO_HIGH@40:35.000 ACKED@40:35.000
HIGH
### acked-after-escalation 
cfg high=30 low=10 deadband=2 delay=0 escalate=100
init 0
s 0 35
tick 100
ack 150
tick 500
---
cfg
NORMAL
HIGH TO_HIGH@0:35.000
HIGH ESCALATE@100:35.000
HIGH ACKED@150:35.000
HIGH
### acked-in-fault-reports-nan 
cfg high=30 low=10 deadband=2 delay=0 escalate=0
init 0
s 0 35
s 10 nan
ack 20
---
cfg
NORMAL
HIGH TO_HIGH@0:35.000
FAULT TO_FAULT@10:nan
FAULT ACKED@20:nan
### ack-in-maintenance-is-silent 
cfg high=30 low=10 deadband=2 delay=0 escalate=100
init 0
s 0 35
maint 10 on
ack 20
maint 30 off
tick 200
---
cfg
NORMAL
HIGH TO_HIGH@0:35.000
HIGH
HIGH
HIGH
HIGH
