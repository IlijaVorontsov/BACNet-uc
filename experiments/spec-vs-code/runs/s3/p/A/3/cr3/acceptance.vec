OK 750500f48fbfbf
OK 750b0048c3a9e282acf09f9880
### utf8-ill-formed
# CR-103: ill-formed UTF-8 is rejected and nothing is written
# stray continuation octets and invalid lead octets
enc_str 80
enc_str 41bf
enc_str fe
enc_str ff
# truncated sequences (at the end, and interrupted by another character)
enc_str c2
enc_str e0a0
enc_str f09080
enc_str 41e282
enc_str c241
enc_str e28241
enc_str f0908041
enc_str e2e282ac
# overlong encodings
enc_str c080
enc_str c1bf
enc_str e08080
enc_str e09fbf
enc_str f0808080
enc_str f08fbfbf
# surrogates U+D800..U+DFFF
enc_str eda080
enc_str edbfbf
enc_str eda0bdedb880
# above U+10FFFF
enc_str f4908080
enc_str f5808080
enc_str f7bfbfbf
enc_str f888808080
# ill-formed octet after a long valid prefix, small buffer
enc_str rep:41:300+ff
enc_str 80 @1
