### ack-does-not-ack-alarm-announced-by-same-call ack escalation
# An alarm that becomes due inside the ack call itself has not been seen by
# the operator, so that ack does not acknowledge it.
cfg high=30 low=10 deadband=2 delay=30 escalate=100
init 0
s 0 35
ack 30
tick 129
tick 130
---
cfg
NORMAL
NORMAL
HIGH TO_HIGH@30:35.000
HIGH
HIGH ESCALATE@130:35.000

### ack-covers-older-alarm-but-not-same-call-one ack escalation
cfg high=30 low=10 deadband=2 delay=30 escalate=100
init 0
s 0 35
s 30 35
s 40 5
ack 70
tick 130
tick 169
tick 170
---
cfg
NORMAL
NORMAL
HIGH TO_HIGH@30:35.000
HIGH
LOW TO_LOW@70:5.000
LOW
LOW
LOW ESCALATE@170:5.000

