### flapping-point-escalates-from-first-alarm escalation fault
# Flapping must not postpone escalation: new alarms join the earliest open
# deadline; an alarm after an escalation opens a new one.
cfg high=30 low=10 deadband=2 delay=0 escalate=100
init 0
s 10 35
sf 50 35
s 90 35
tick 110
sf 150 35
tick 249
tick 250
---
cfg
NORMAL
HIGH TO_HIGH@10:35.000
FAULT TO_FAULT@50:35.000
HIGH TO_NORMAL@90:35.000 TO_HIGH@90:35.000
HIGH ESCALATE@110:35.000
FAULT TO_FAULT@150:35.000
FAULT
FAULT ESCALATE@250:35.000

### escalate-zero-means-with-the-alarm escalation
cfg high=30 low=10 deadband=2 delay=0 escalate=0
init 0
s 10 35
tick 20
sf 30 35
ack 40
s 50 5
---
cfg
NORMAL
HIGH TO_HIGH@10:35.000 ESCALATE@10:35.000
HIGH
FAULT TO_FAULT@30:35.000 ESCALATE@30:35.000
FAULT
LOW TO_NORMAL@50:5.000 TO_LOW@50:5.000 ESCALATE@50:5.000

### catch-up-transition-due-before-escalation escalation tick
# Several due events in one call come out in the order they fell due; the
# result matches what intermediate ticks would have produced.
cfg high=30 low=10 deadband=2 delay=30 escalate=100
init 0
s 0 35
s 30 35
s 60 5
tick 200
tick 1000
---
cfg
NORMAL
NORMAL
HIGH TO_HIGH@30:35.000
HIGH
LOW TO_LOW@200:5.000 ESCALATE@200:5.000
LOW

