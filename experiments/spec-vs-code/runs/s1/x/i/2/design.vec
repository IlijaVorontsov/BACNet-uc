# Regression vectors for the behaviour choices documented at the top of alarm.c.
# Run: python3 run_vectors.py acceptance.vec design.vec
### fault-immediate-clear-goes-normal-then-delay
cfg high=30 low=10 deadband=2 delay=30 escalate=600
init 0
s 10 35
sf 20 35
sf 30 35
s 40 35
s 70 35
ack 80
s 90 nan
s 100 20
---
cfg
NORMAL
NORMAL
FAULT TO_FAULT@20:35.000
FAULT
NORMAL TO_NORMAL@40:35.000
HIGH TO_HIGH@70:35.000
HIGH
FAULT TO_FAULT@90:nan
NORMAL TO_NORMAL@100:20.000
### high-to-low-is-a-new-occurrence
cfg high=30 low=10 deadband=2 delay=30 escalate=600
init 0
s 0 35
s 30 35
ack 31
s 40 5
s 70 5
tick 700
---
cfg
NORMAL
NORMAL
HIGH TO_HIGH@30:35.000
HIGH
HIGH
LOW TO_LOW@70:5.000
LOW ESCALATE@700:5.000
### late-call-uses-held-value
cfg high=30 low=10 deadband=2 delay=30 escalate=600
init 0
s 0 35
s 100 20
---
cfg
NORMAL
NORMAL
HIGH TO_HIGH@100:35.000
### late-call-replays-in-time-order
cfg high=30 low=10 deadband=2 delay=30 escalate=100
init 0
s 0 35
s 30 35
s 110 20
s 120 5
sf 500 0
---
cfg
NORMAL
NORMAL
HIGH TO_HIGH@30:35.000
HIGH
HIGH
FAULT ESCALATE@500:5.000 TO_NORMAL@500:5.000 TO_LOW@500:5.000 TO_FAULT@500:0.000
### maint-suppresses-then-resyncs
cfg high=30 low=10 deadband=2 delay=30 escalate=600
init 0
maint 5 on
s 10 35
s 40 35
maint 50 off
tick 649
tick 650
---
cfg
NORMAL
NORMAL
NORMAL
HIGH
HIGH TO_HIGH@50:35.000
HIGH
HIGH ESCALATE@650:35.000
### maint-cleared-alarm-sends-to-normal-at-exit
