cfg
NORMAL
NORMAL
NORMAL
NORMAL
HIGH TO_HIGH@131:30.010
HIGH
HIGH
HIGH
NORMAL TO_NORMAL@231:27.990
### delay0-escalate0-inf
cfg high=30 low=10 deadband=2
init 0
s 0 inf
s 1 -inf
s 2 20
tick 100000
---
cfg
NORMAL
HIGH TO_HIGH@0:inf
LOW TO_LOW@1:-inf
NORMAL TO_NORMAL@2:20.000
NORMAL
### fault-clear-with-delay0
cfg high=30 low=10 deadband=2
init 0
sf 0 0
s 1 35
---
cfg
NORMAL
FAULT TO_FAULT@0:0.000
HIGH TO_NORMAL@1:35.000 TO_HIGH@1:35.000
### swapped-limits-negative-deadband
cfg high=10 low=30 deadband=-5 delay=0
init 0
s 0 20
s 1 31
s 2 29.9
---
cfg
NORMAL
NORMAL
HIGH TO_HIGH@1:31.000
NORMAL TO_NORMAL@2:29.900
