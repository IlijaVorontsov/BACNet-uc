# Edge cases for decisions acceptance.vec leaves open (see header of alarm.c).
### limits-are-strict-and-deadband-is-return-only
cfg high=30 low=10 deadband=2 delay=0 escalate=0
init 0
s 1 30
s 2 10
s 3 30.5
s 4 28
s 5 27.9
s 6 9.5
s 7 12
s 8 12.1
---
cfg
NORMAL
NORMAL
NORMAL
HIGH TO_HIGH@3:30.500
HIGH
NORMAL TO_NORMAL@5:27.900
LOW TO_LOW@6:9.500
LOW
NORMAL TO_NORMAL@8:12.100
