# Regression vectors for the fixes listed in REVIEW.md.
### r01 stale-tick-does-not-fire-delay-timer
cfg high=30 low=10 deadband=2 delay=30 escalate=600
init 0
s 10 35
s 20 35
tick 5
tick 40
---
cfg
NORMAL
NORMAL
NORMAL
NORMAL
HIGH TO_HIGH@40:35.000
### r02 stale-tick-does-not-escalate
cfg high=30 low=10 deadband=2 delay=0 escalate=100
init 0
s 50 35
tick 40
tick 149
tick 150
---
cfg
NORMAL
HIGH TO_HIGH@50:35.000
HIGH
HIGH
HIGH ESCALATE@150:35.000
