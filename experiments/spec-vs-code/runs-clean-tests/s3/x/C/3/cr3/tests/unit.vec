### x072 CR203 A8 A9
# ACKED for a LOW alarm carries the most recent sample value, also after escalation;
# a second ack has nothing to acknowledge.
cfg high=30 low=10 deadband=2 delay=0 escalate=100
init 0
s 0 5
s 50 4
tick 100
ack 110
ack 120
tick 300
---
cfg
NORMAL
LOW TO_LOW@0:5.000
LOW
LOW ESCALATE@100:4.000
LOW ACKED@110:4.000
LOW
LOW
### x073 CR203 A10
# An alarm reached during maintenance is not unacknowledged until it is reported,
# so an ack during maintenance emits nothing; once reported, ack emits ACKED.
cfg high=30 low=10 deadband=2 delay=0 escalate=600
init 0
maint 0 on
s 10 35
ack 20
maint 30 off
ack 40
---
cfg
NORMAL
NORMAL
HIGH
HIGH
HIGH TO_HIGH@30:35.000
HIGH ACKED@40:35.000
### x074 CR203 A6
# Ack while in FAULT after a NaN sample: ACKED carries the NaN sample value.
cfg high=30 low=10 deadband=2 delay=0 escalate=600
init 0
s 0 35
s 10 nan
ack 20
---
cfg
NORMAL
HIGH TO_HIGH@0:35.000
FAULT TO_FAULT@10:nan
FAULT ACKED@20:nan
### x075 CR203 A5a
# A pending transition that matures in the ack call is reported before ACKED.
